@page
@model MoveModel
@{
    ViewData["Title"] = "Tafel verplaatsen of samenvoegen";
    ViewData["Nav"] = "tables";
}
@* UC-12, UC-23: alles naar een andere tafel, samenvoegen als die tafel open is. Moet snel gaan (Jieou 6).
     Eten en drinken apart afrekenen gebeurt op de rekening (15), niet door te verplaatsen. *@
<div class="app"><partial name="_Rail" /><partial name="_OrderScreen" /></div>
<div class="sluier"><form class="dlg breed" method="post" asp-page="/Tables/Index" asp-page-handler="Move">
  <h2>Tafel verplaatsen</h2>
  <p class="sub"></p>

  <div class="veld"><label>Naar</label>
    <div class="keuzes tafels">
      @* <label class="keuze"><input type="radio" name="targetTable" value="[nummer]">[nummer]<span class="delta">open</span></label> *@
    </div></div>

  <div class="melding">
    <b>Naar een open tafel</b>
    <span>De bestelling komt bij die van de andere tafel en deze tafel wordt vrij. Verstuurde regels blijven verstuurd.</span>
  </div>

  <div class="acties"><a class="knop leeg" asp-page="/Orders/Index">Annuleren</a><button type="submit" class="knop rood">Verplaatsen</button></div>
</form></div>
