@page
@model IndexModel
@{
    ViewData["Title"] = "Tafels";
    ViewData["Nav"] = "tables";
}
@* FR-01, FR-02: alle 16 tafels, vrij of open. Iedereen bedient elke tafel, dus er is geen "eigen tafel". *@
<div class="app geen-paneel">
<partial name="_Rail" />
  <main class="mid">
    <div class="pagkop">
      <div><h1>Tafels</h1><p></p></div>
      <div class="rechts"></div>
    </div>
    <div style="padding:0 20px 14px;flex:1;min-height:0;display:flex;flex-direction:column">
      <div class="zone" style="flex:1;min-height:0">
        <div class="zkop"><span>Restaurant</span><span>tik op een tafel om te bestellen</span></div>
        <div class="grid-t">
          @* Vrije tafel:
          <a class="tafel vrij" asp-page="/Orders/Index" asp-route-table="[nummer]"><b>[nummer]</b><span class="st">vrij</span></a>
          Open tafel, met "mijn" als er regels zijn die nog niet verstuurd zijn:
          <a class="tafel bezet mijn" asp-page="/Orders/Index" asp-route-table="[nummer]"><b>[nummer]</b><span class="st">geopend [tijd] · <span style="color:var(--signal)">[aantal] nieuw</span></span><span class="bed">[bedrag]</span></a> *@
        </div>
      </div>
    </div>
    <div class="tafelbalk">
      <div class="tb"><span class="info"><i>rode rand: er zijn regels die nog niet verstuurd zijn</i></span></div>
    </div>
  </main>
</div>
