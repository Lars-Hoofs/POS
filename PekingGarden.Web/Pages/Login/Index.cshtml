@page
@model IndexModel
@{
    ViewData["Title"] = "Inloggen";
}
<div class="app vol inloggen">
  <div class="inloggen-namen">
    <div class="merk" style="padding:0"><img class="glyph" src="~/icons/logo.svg" alt=""><b>Peking Garden</b></div>
    <div>
      <label>Wie ben je?</label>
      <div class="mwkeuze" style="grid-template-columns:1fr" data-login-names>
      </div>
    </div>
    <div></div>
  </div>

  <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:40px">
    <div style="font-family:var(--label);font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted-2)">Pincode <span data-login-name></span></div>
    <h2 style="font-family:var(--med);font-size:21px;font-weight:500;margin-top:8px">Voer je vier cijfers in</h2>
    <div class="bollen" data-pin-dots><i></i><i></i><i></i><i></i></div>
    <form id="login" method="post" asp-page="/Tables/Index">
      <input type="hidden" name="pin" data-pin-value>
    </form>
    <div class="pin">
      <button type="button" data-digit="1">1</button><button type="button" data-digit="2">2</button><button type="button" data-digit="3">3</button>
      <button type="button" data-digit="4">4</button><button type="button" data-digit="5">5</button><button type="button" data-digit="6">6</button>
      <button type="button" data-digit="7">7</button><button type="button" data-digit="8">8</button><button type="button" data-digit="9">9</button>
      <span class="leeg"></span><button type="button" data-digit="0">0</button><button type="button" class="wis" data-pin-clear>wis</button>
    </div>
    <p style="font-size:12px;color:var(--muted);margin-top:22px;text-align:center;max-width:280px">
      Na vijf foute codes moet je een minuut wachten.</p>
  </div>
</div>
