@page
@model IndexModel
@{
    ViewData["Title"] = "Rekening en tafel sluiten";
    ViewData["Nav"] = "tables";
}
<div class="app">
<partial name="_Rail" />
  <main class="mid">
    <div class="pagkop"><div><h1>Rekening</h1><p></p></div></div>
    <div class="bonnen">
<div class="papier">       PEKING GARDEN
         Stramproy
<b>TAFEL</b>
----------------------------------
----------------------------------
<b>TOTAAL</b>

----------------------------------
      Bedankt en tot ziens</div>
    </div>
  </main>
  <aside class="paneel">
    <div class="tafelkop"><div><h1>Tafel</h1><p></p></div></div>
    <div class="melding info" style="margin-top:0">
      <b>Nog iets bijbestellen?</b>
      <span>Kan gewoon. Voeg het toe op de tafel en print de rekening opnieuw.</span></div>
    <div class="veld" style="margin-top:14px"><label>Rekening</label>
      <div class="tabs"><a class="t aan" asp-page="/Bills/Index">Eén rekening</a><a class="t" asp-page="/Bills/Split">Eten en drinken apart</a></div></div>
    <div class="totalen">
      <div class="tot-r"><span>Btw 9%</span><span></span></div>
      <div class="tot-r"><span>Btw 21%</span><span></span></div>
      <div class="tot-lijn"></div>
      <div class="tot-groot"><span>Totaal</span><b></b></div>
      <button type="button" class="knop" style="margin-top:14px" data-print>Rekening printen</button>
      <form method="post" asp-page="/Tables/Index" asp-page-handler="Close"><button type="submit" class="knop rood" style="margin-top:8px">Tafel sluiten: gast heeft betaald</button></form>
      <a class="knop leeg" asp-page="/Orders/Index" style="margin-top:8px">Terug naar de tafel</a>
    </div>
  </aside>
</div>
