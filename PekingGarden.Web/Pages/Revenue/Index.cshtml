@page
@model IndexModel
@{
    ViewData["Title"] = "Omzet per dag";
    ViewData["Nav"] = "revenue";
    ViewData["Role"] = "Manager";
}
@* FR-16 (Could): Ying wil als manager de omzet per dag zien. Alleen zichtbaar voor de rol Manager (NFR-05).
     De cijfers zijn voorbeeldcijfers. *@
<div class="app geen-paneel">
<partial name="_Rail" />
  <main class="mid">
    <div class="pagkop">
      <div><h1>Omzet</h1><p></p></div>
      <div class="rechts"><a class="pil nieuw" asp-page="/Revenue/Index">‹ vorige dag</a><a class="pil nieuw" asp-page="/Revenue/Index">vandaag</a></div>
    </div>
    <div style="padding:0 20px 14px"><div class="kaarten">
      <div class="kaart"><div class="kop">Omzet</div><b></b><span>inclusief btw</span></div>
      <div class="kaart"><div class="kop">Gesloten tafels</div><b></b><span></span></div>
      <div class="kaart"><div class="kop">Btw 9%</div><b></b><span></span></div>
      <div class="kaart"><div class="kop">Btw 21%</div><b></b><span></span></div>
    </div></div>
    <div class="omzet-lijsten">
      <div class="zone">
        <div class="zkop"><span>Meest besteld</span><span>aantal · omzet</span></div>
        <table>
          <tr><th>Nr</th><th>Product</th><th class="num">Aantal</th><th class="num">Omzet</th></tr>
          @* <tr><td>[nummer]</td><td>[product]</td><td class="num">[aantal]</td><td class="num">[omzet]</td></tr> *@
        </table>
      </div>
      <div class="zone">
        <div class="zkop"><span>Afgelopen week</span><span>omzet per dag</span></div>
        <table>
          <tr><th>Dag</th><th class="num">Tafels</th><th class="num">Omzet</th></tr>
          @* <tr><td>[dag]</td><td class="num">[tafels]</td><td class="num">[omzet]</td></tr> *@
        </table>
      </div>
    </div>
  </main>
</div>
